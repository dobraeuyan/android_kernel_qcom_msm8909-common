/ {
	model = "HTC Desire 530";
	compatible = "htc,msm8909-a16", "qcom,msm8909-mtp",
			"qcom,msm8909", "qcom,mtp";
	qcom,msm-id = <0x197 0x0 0x198 0x0 0x19a 0x0 0x1a8 0x0>;
	qcom,board-id = <0x0 0x0>;
};

&i2c_5 {
	status = "okay";

	himax@48 {
		compatible = "himax,852xes";
		reg = <0x48>;
		status = "okay";
		interrupt-parent = <&msm_gpio>;
		interrupts = <13 0x2>;
		himax,panel-coords = <0 1080 0 1920>;
		himax,display-coords = <0 720 0 1280>;
		himax,irq-gpio = <&msm_gpio 13 0x00>;
		himax,rst-gpio = <&msm_gpio 12 0x00>;
		himax,3v3-gpio = <&msm_gpio 99 0x00>;
		report_type = <1>;

		pinctrl-names = "pmx_ts_active", "pmx_ts_suspend";
		pinctrl-0 = <&a16_ts_reset_active &a16_ts_int_active
				&a16_ts_power_active>;
		pinctrl-1 = <&a16_ts_reset_suspend &a16_ts_int_suspend
				&a16_ts_power_suspend>;

