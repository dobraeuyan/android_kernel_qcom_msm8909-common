&msm_gpio {
	pmx_a16_ts_reset {
		a16_ts_reset_active: a16_ts_reset_active {
			mux {
				pins = "gpio12";
				function = "gpio";
			};
			config {
				pins = "gpio12";
				drive-strength = <2>;
				bias-disable;
			};
		};

		a16_ts_reset_suspend: a16_ts_reset_suspend {
			mux {
				pins = "gpio12";
				function = "gpio";
			};
			config {
				pins = "gpio12";
				drive-strength = <2>;
				bias-disable;
			};
		};
	};

	pmx_a16_ts_int {
		a16_ts_int_active: a16_ts_int_active {
			mux {
				pins = "gpio13";
				function = "gpio";
			};
			config {
				pins = "gpio13";
				drive-strength = <2>;
				bias-disable;
			};
		};

		a16_ts_int_suspend: a16_ts_int_suspend {
			mux {
				pins = "gpio13";
				function = "gpio";
			};
			config {
				pins = "gpio13";
				drive-strength = <2>;
				bias-disable;
			};
		};
	};

	pmx_a16_ts_power {
		a16_ts_power_active: a16_ts_power_active {
			mux {
				pins = "gpio99";
				function = "gpio";
			};
			config {
				pins = "gpio99";
				drive-strength = <2>;
				bias-disable;
			};
		};

		a16_ts_power_suspend: a16_ts_power_suspend {
			mux {
				pins = "gpio99";
				function = "gpio";
			};
			config {
				pins = "gpio99";
				drive-strength = <2>;
				bias-disable;
			};
		};
	};
};

&i2c_5 {
	synaptics@20 {
		status = "disabled";
	};
};

&smb1357_otg_vreg {
	status = "disabled";
};

&pm8909_chg {
	status = "okay";
	qcom,use-external-charger;
	qcom,charging-disabled;
};

&usb_otg {
	vbus_otg-supply = <&smb358_otg_supply>;
	extcon = <&smb358_otg_supply>;

	qcom,hsusb-otg-phy-init-seq = <0x43 0x80 0x3e 0x81
					0x3d 0x82 0x13 0x83 0xffffffff>;

};

&mtp_batterydata {
	/delete-node/ qcom,palladium-batterydata;
	#include "batterydata-htc-a16.dtsi"
};

&pm8909_bms {
	qcom,max-voltage-uv = <4350000>;
	qcom,r-conn-mohm = <20>;
	qcom,s1-fifo-length = <5>;
};

&i2c_4 {
	status = "okay";

	smb358_otg_supply: smb358-charger@57 {
		compatible = "qcom,smb358-charger";
		reg = <0x57>;
		interrupt-parent = <&msm_gpio>;
		interrupts = <58 8>;
		qcom,irq-gpio = <&msm_gpio 58 0x2008>;
		vdd-supply = <&pm8909_l5>;
		qcom,chg-vadc = <&pm8909_vadc>;
		qcom,chg-adc_tm = <&pm8909_adc_tm>;
		qcom,float-voltage-mv = <4350>;
		qcom,iterm-ma = <80>;
		qcom,recharge-mv = <100>;
		qcom,fastchg-current-max-ma = <1500>;
		qcom,bms-psy-name = "bms";
		qcom,chg-inhibit-disabled;
		qcom,using-pmic-therm;

		qcom,using-vbat-sns;
		qcom,bms-controlled-charging;
		qcom,charging-timeout = <764>;
		qcom,cold-bat-decidegc = <0>;
		qcom,cool-bat-decidegc = <100>;
		qcom,warm-bat-decidegc = <480>;
		qcom,hot-bat-decidegc = <550>;
		qcom,bat-present-decidegc = <200>;
		qcom,cool-bat-ma = <1500>;
		qcom,warm-bat-ma = <1500>;
		qcom,cool-bat-mv = <4350>;
		qcom,warm-bat-mv = <4000>;
		regulator-name = "smb358_otg_vreg";
	};
};

&soc {
	restart@4ab000 {
		qcom,force-warm-reboot;
	};
};

&soc {
	gpio_keys {
		compatible = "gpio-keys";
		input-name = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&gpio_key_active>;

		/delete-node/ camera_focus;
		/delete-node/ camera_snapshot;

		vol_up {
			label = "volume_up";
			gpios = <&msm_gpio 90 0x1>;
			linux,input-type = <1>;
			linux,code = <115>;
			debounce-interval = <15>;
			gpio-key,wakeup;
		};

	};
};

&wcnss {
	status = "okay";
};

&vendor_fstab {
	dev = "/dev/block/platform/soc/7824900.sdhci/by-name/cache";
	fsmgr_flags = "wait";
};

&system_fstab {
	status = "ok";
	fsmgr_flags = "wait";
};

&audio_codec_mtp {
	qcom,afe-legacy-clock-set;

	htc,spk-gpio-5v-en = <&msm_gpio 10 0x0>;

	qcom,msm-mbhc-hphl-swh = <1>;
	qcom,msm-mbhc-gnd-swh = <1>;
	qcom,msm-hs-micbias-type = "external";

};

&spk_vreg {
	status = "disabled";
};

&pm8909_gpios {
	gpio@c000 {
		status = "okay";
		qcom,mode = <1>;
		qcom,invert = <0>;
		qcom,vin-sel = <3>;
		qcom,src-sel = <0>;
		qcom,out-strength = <1>;
		qcom,master-en = <1>;
	};
};

&soc {
	htc_radio_smem {
		compatible = "htc,htc_radio_smem";
		reg = <0x8e3f0000 0x10000>;
		reg-names = "smem-start-addr";
	};
};
