			"sensor_gpio_reset", "sensor_gpio_standby";
		qcom,cam-power-seq-cfg-val = <0 0 1 1 1 24000000 1 1>;
		qcom,cam-power-seq-delay = <1 1 10 10 10 10 1 1>;
		status = "ok";
		clocks = <&clock_gcc clk_mclk0_clk_src>,
