&audio_codec_mtp {
	status = "okay";
	qcom,model = "msm8909-pm8916-snd-card";
	pinctrl-names = "default";
	pinctrl-0 = <&spk_ext_pa_active>;

	qcom,msm-mbhc-hphl-swh = <1>;
	qcom,msm-mbhc-gnd-swh = <1>;
	qcom,cdc-us-euro-gpios = <&msm_gpio 16 0>;

	/delete-property/ qcom,cdc-us-eu-gpios;

	qcom,msm-spk-ext-pa = <&msm_gpio 97 0>;
	qcom,msm-spk-ext-pa-left = <&msm_gpio 97 0>;
	qcom,msm-spk-ext-pa-right = <&msm_gpio 20 0>;

	/delete-property/ qcom,msm-micbias1-ext-cap;
	qcom,audio-routing =
		"RX_BIAS", "MCLK",
		"SPK_RX_BIAS", "MCLK",
		"INT_LDO_H", "MCLK",
		"MIC BIAS Internal1", "Handset Mic",
		"MIC BIAS Internal2", "Headset Mic",
		"MIC BIAS Internal3", "Secondary Mic",
		"AMIC1", "MIC BIAS Internal1",
		"AMIC2", "MIC BIAS Internal2",
		"AMIC3", "MIC BIAS Internal3";
};

&cdc_us_euro_sw {
	status = "disabled";
};

&i2c_2 {
	nq@28 {
		status = "disabled";
	};
};

&pm8916_gpios {
	nfc_clk {
		nfc_clk_default: nfc_clk_default {
			status = "okay";
		};
	};
};

&msm_gpio {

	hsuart_active: default {
		mux {
			pins = "gpio20", "gpio21", "gpio111", "gpio112";
			function = "blsp_uart2";
		};

		config {
			pins = "gpio20", "gpio21", "gpio111", "gpio112";
			drive-strength = <16>;
			bias-disable;
		};
	};

	hsuart_sleep: sleep {
		mux {
			pins = "gpio20", "gpio21", "gpio111", "gpio112";
			function = "blsp_uart2";
		};

		config {
			pins = "gpio20", "gpio21", "gpio111", "gpio112";
			drive-strength = <2>;
			bias-disable;
		};
	};

	ctp_eint_as_int: ctp_eint_as_int {
		mux {
			pins = "gpio13";
			function = "gpio";
		};
		config {
			pins = "gpio13";
			drive-strength = <8>;
			input-enable;
			bias-disable;
		};
	};

	ctp_eint_output_low: ctp_eint_output_low {
		mux {
			pins = "gpio13";
			function = "gpio";
		};
		config {
			pins = "gpio13";
			drive-strength = <8>;
			bias-pull-down;
			output-low;
		};
	};

	ctp_eint_output_high: ctp_eint_output_high {
		mux {
			pins = "gpio13";
			function = "gpio";
		};
		config {
			pins = "gpio13";
			drive-strength = <8>;
			bias-pull-up;
			output-high;
		};
	};

	spk_ext_pa_active: spk_ext_pa_active {
		mux {
			pins = "gpio97", "gpio20";
			function = "gpio";
		};
		config {
			pins = "gpio97", "gpio20";
			drive-strength = <8>;
			bias-disable;
			output-low;
			input-enable;
		};
	};

};

&soc {

	i2c@78b9000 {
		synaptics@20 {
			status = "disabled";
		};
	};

	blsp1_uart2_hs: uart@78b0000 {
		compatible = "qcom,msm-hsuart-v14";
		reg = <0x78b0000 0x200>,
			<0x7884000 0x1f000>;
		reg-names = "core_mem", "bam_mem";
		interrupt-names = "core_irq", "bam_irq", "wakeup_irq";
		#address-cells = <0>;
		interrupt-parent = <&blsp1_uart2_hs>;
		interrupts = <0 1 2>;
		#interrupt-cells = <1>;
		interrupt-map-mask = <0xffffffff>;
		interrupt-map = <0 &intc 0 108 0
				1 &intc 0 238 0
				2 &msm_gpio 21 0>;
		qcom,inject-rx-on-wakeup;
		qcom,rx-char-to-inject = <0xfd>;
		qcom,master-id = <86>;
		clock-names = "core_clk", "iface_clk";
		clocks = <&clock_gcc clk_gcc_blsp1_uart2_apps_clk>,
				<&clock_gcc clk_gcc_blsp1_ahb_clk>;
		pinctrl-names = "sleep", "default";
		pinctrl-0 = <&hsuart_sleep>;
		pinctrl-1 = <&hsuart_active>;
		qcom,bam-tx-ep-pipe-index = <2>;
		qcom,bam-rx-ep-pipe-index = <3>;
		qcom,msm-bus,name = "blsp1_uart2_hs";
		qcom,msm-bus,num-cases = <2>;
		qcom,msm-bus,num-paths = <1>;
		qcom,msm-bus,vectors-KBps =
				<86 512 0 0>,
				<86 512 500 800>;
		status = "disabled";
	};

	cdc_pri_mi2s_gpios: msm_cdc_pinctrl_pri {
		compatible = "qcom,msm-cdc-pinctrl";
		pinctrl-names = "aud_active", "aud_sleep";
		pinctrl-0 = <&cdc_pdm_lines_act>;
		pinctrl-1 = <&cdc_pdm_lines_sus>;
	};

	cdc_quat_mi2s_gpios: msm_cdc_pinctrl_quat {
		compatible = "qcom,msm-cdc-pinctrl";
		pinctrl-names = "aud_active", "aud_sleep";
		pinctrl-0 = <&quat_mi2s_active &quat_mi2s_din_active>;
		pinctrl-1 = <&quat_mi2s_sleep &quat_mi2s_din_sleep>;
	};

	wcd_rst_gpio: wcd_gpio_ctrl {
		compatible = "qcom,msm-cdc-pinctrl";
		pinctrl-names = "aud_active", "aud_sleep";
		pinctrl-0 = <&cdc_reset_active>;
		pinctrl-1 = <&cdc_reset_sleep>;
	};
};

&wcnss {
	status = "okay";

	/delete-property/ qcom,wcnss-pm;
};

&soc {
	sdc2_vdd_enable: regulator_sdc2_vdd_en {
		compatible = "regulator-fixed";
		regulator-name = "sdc2_vdd_enable";
		startup-delay-us = <1000>;
		enable-active-high;
		gpio = <&msm_gpio 17 0>;
		regulator-always-on;
		regulator-boot-on;
	};
};

&sdhc_2 {

	cd-gpios = <&msm_gpio 38 0>;

	#address-cells = <0>;
	interrupt-parent = <&sdhc_2>;
	interrupts = <0 1 2>;
	#interrupt-cells = <1>;
	interrupt-map-mask = <0xffffffff>;
	interrupt-map = <0 &intc 0 125 0
			1 &intc 0 221 0
			2 &msm_gpio 38 0>;
	interrupt-names = "hc_irq", "pwr_irq", "status_irq";

	vdd-supply = <&pm8916_l11>;
	qcom,vdd-voltage-level = <1800000 2950000>;
	qcom,vdd-current-level = <15000 400000>;

	vdd-io-supply = <&pm8916_l12>;
	qcom,vdd-io-voltage-level = <1800000 2950000>;
	qcom,vdd-io-current-level = <200 50000>;

	pinctrl-names = "active", "sleep";
	pinctrl-0 = <&sdc2_clk_on &sdc2_cmd_on &sdc2_data_on &sdc2_cd_on>;
	pinctrl-1 = <&sdc2_clk_off &sdc2_cmd_off &sdc2_data_off &sdc2_cd_off>;

	status = "ok";
};

&i2c_4 {
	status = "okay";

	smb358_otg_supply: smb358-charger@57 {
		compatible = "qcom,smb358-charger";
		reg = <0x57>;
		interrupt-parent = <&msm_gpio>;
		interrupts = <58 8>;
		qcom,irq-gpio = <&msm_gpio 58 0x2008>;
		pinctrl-names = "default";
		pinctrl-0 = <&smb_int_default>;
		qcom,bms-psy-name = "bms";
		qcom,chg-vadc = <&pm8916_vadc>;
		qcom,chg-adc_tm = <&pm8916_adc_tm>;
		qcom,float-voltage-mv = <4400>;
		qcom,iterm-ma = <200>;
		qcom,bms-controlled-charging;
		qcom,using-vbat-sns;
		qcom,using-pmic-therm;
		qcom,thermal-mitigation = <1500 700 600 0>;
		regulator-name = "smb358_otg_vreg";
		qcom,cold-bat-decidegc = <0>;
		qcom,cool-bat-decidegc = <150>;
		qcom,warm-bat-decidegc = <450>;
		qcom,hot-bat-decidegc = <500>;
		qcom,bat-present-decidegc = <250>;
		qcom,cool-bat-ma = <1500>;
		qcom,warm-bat-ma = <1500>;
		qcom,fastchg-current-max-ma = <2000>;

		qcom,dcp-input-current-ma = <2000>;
		qcom,recharge-mv = <100>;
		qcom,cool-bat-mv = <4400>;
		qcom,warm-bat-mv = <4100>;
	};
};

&pm8916_bms {
	status = "okay";
	qcom,battery-data = <&mtp_batterydata>;
	qcom,max-voltage-uv = <4400000>;
	qcom,batt-aging-comp;
};

&pm8916_vadc {
	chan@76 {
		label = "usbid";
		reg = <0x76>;
		qcom,decimation = <0>;
		qcom,pre-div-channel-scaling = <0>;
		qcom,calibration-type = "absolute";
		qcom,scale-function = <0>;
		qcom,hw-settle-time = <0>;
		qcom,fast-avg-setup = <0>;
	};
};

&pm8916_adc_tm {
	chan@76 {
		label = "usbid";
		reg = <0x76>;
		qcom,decimation = <0>;
		qcom,pre-div-channel-scaling = <0>;

		qcom,calibration-type = "ratiometric";
		qcom,scale-function = <2>;
		qcom,hw-settle-time = <0>;
		qcom,fast-avg-setup = <0>;
		qcom,btm-channel-number = <0x88>;
	};
};

&usb_otg {

	interrupts = <0 134 0>, <0 140 0>;
	interrupt-names = "core_irq", "async_irq";
	qcom,hsusb-otg-mode = <3>;
	vbus_otg-supply = <&smb358_otg_supply>;

	qcom,usbid-vadc = <&pm8916_vadc>;
	qcom,usbid-adc_tm = <&pm8916_adc_tm>;

	extcon = <&smb358_otg_supply>;
};

&mdss_dsi0 {
	qcom,dsi-pref-prim-pan = <&dsi_nt35521z_inx101_video>;
};

&dsi_nt35521z_inx101_video {
	qcom,cont-splash-enabled;
	qcom,mdss-white-point = <29103 29141 25390>;
};

&dsi_jd9365_boe_video {
	qcom,cont-splash-enabled;
};

&dsi_jd9365_starry_video {
	qcom,cont-splash-enabled;
};

&i2c_5 {
	status = "okay";

	silead_gsl@40 {
		compatible = "silead,gsl-tp";
		gsl,name = "gsl_ctp";
		reg = <0x40>;
		interrupt-parent = <&msm_gpio>;
		interrupts = <13 0x2001>;
		vdd-supply = <&pm8916_l17>;
		vcc_i2c-supply = <&pm8916_l6>;
		pinctrl-names = "pmx_ts_active", "pmx_ts_suspend";
		pinctrl-0 = <&ts_int_active &ts_reset_active>;
		pinctrl-1 = <&ts_int_suspend &ts_reset_suspend>;
		gsl,display-coords = <0 0 1280 800>;
		gsl,panel-coords = <0 0 1280 800>;
		gsl,hard-reset-delay-ms = <5>;
		gsl,post-hard-reset-delay-ms = <5>;
		gsl,reset-gpio = <&msm_gpio 12 0x00>;
		gsl,irq-gpio = <&msm_gpio 13 0x2001>;
		gsl,num-max-touches = <10>;
		gsl,panel_tx_num = <24>;
		gsl,panel_rx_num = <14>;
		gsl,button-map = <158 139 172>;
		gsl,i2c-pull-up;
	};

	Goodix-TS@14 {
		compatible = "goodix,Goodix-TS";
		reg = <0x14>;
		interrupt-parent = <&msm_gpio>;
		interrupts = <13 0x2008>;
		vdd-supply = <&pm8916_l17>;
		vcc_i2c-supply = <&pm8916_l6>;
		pinctrl-names = "eint_as_int", "eint_output_low",
				"eint_output_high";
		pinctrl-0 = <&ctp_eint_as_int>;
		pinctrl-1 = <&ctp_eint_output_low>;
		pinctrl-2 = <&ctp_eint_output_high>;
		goodix,reset-gpio = <&msm_gpio 12 0x00>;
		goodix,display-coords = <0 0 1280 800>;
		goodix,panel-coords = <0 0 1280 800>;
		goodix,irq-gpio = <&msm_gpio 13 0x00>;
		goodix,button-map = <158 139 172>;
		goodix,i2c-pull-up;
		goodix,module-name = "mutto", "mutto charger cfg",
			"unknow", "unknow", "unknow",
			"xingqihong", "xingqihong charger cfg", "unknow";
		goodix,cfg-data0 = [4e 20 03 00 05 0a 3d 00 22 ce 46
			0a 50 37 0f 35 00 00 00 02 11 11 06 17 19 1b 14 95 35
			ff 1c 1e c8 12 00 00 00 42 34 1c 00 00 00 00 00 00 00
			64 b4 00 2b 13 23 8a c0 46 00 3c 01 04 8c 14 00 83 16
			00 78 19 00 6e 1d 00 6e 20 00 68 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00 00 00 00 00 00 0f 0f 28 00 3c
			28 03 00 00 00 00 02 00 00 0f 00 1d 1c 1b 1a 19 18 17
			16 15 14 13 12 11 10 0f 0e 0d 0c 0b 0a 09 08 07 06 05
			04 03 02 01 00 2a 29 28 27 26 25 24 23 22 21 20 1f 1e
			1d 1c 1b 19 18 17 16 15 14 13 12 11 10 0f 0e 0d 0c 0b
			0a 09 08 07 06 05 04 03 02 01 00 cd 01];
		goodix,cfg-data2 = [49 20 03 00 05 0a 3d 00 22 ce 43
			0a 50 3c 0f 35 00 00 00 02 11 11 09 17 19 1b 14 95 35
			ff 14 16 c8 12 00 00 00 42 34 1c 00 00 00 00 00 00 00
			64 b4 00 03 13 23 8d c0 78 00 3c 01 04 8d 14 00 85 16
			00 7c 19 00 75 1d 00 70 20 00 70 00 00 00 00 00 00 00
