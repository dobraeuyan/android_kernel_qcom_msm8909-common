/dts-v1/;

#include "msm8909-mtp.dtsi"
#include "8909-pm8916.dtsi"
#include "msm8909-pm8916-mtp.dtsi"
#include "apq8009-memory.dtsi"
#include "dsi-panel-nt35521s-xingyuan-wxga-video.dtsi"
#include "dsi-panel-otm1287a-kd-wxga-video.dtsi"
#include "dsi-panel-nt35521-wxga-video.dtsi"
#include "msm8909-x103f-camera.dtsi"

/ {
	model = "Lenovo Tab 10";
	compatible = "lenovo,x103f", "qcom,msm8009-mtp",
			"qcom,msm8909", "qcom,mtp";
	qcom,msm-id = <0xf5 0x0 0x102 0x0 0x109 0x0 0x113 0x0>;
	qcom,board-id = <0x8 0x8 0x1000b 0x8>;
};

&mdss_dsi0 {
	qcom,dsi-pref-prim-pan = <&dsi_nt35521s_xingyuan_wxga_video>;
};

&dsi_nt35521s_xingyuan_wxga_video {
	qcom,cont-splash-enabled;

	qcom,mdss-white-point = <32768 31653 25162>;

	qcom,mdss-pan-physical-width-dimension = <137>;
	qcom,mdss-pan-physical-height-dimension = <217>;
};

&dsi_otm1287a_kd_wxga_video {
	qcom,cont-splash-enabled;
	qcom,mdss-pan-physical-width-dimension = <137>;
	qcom,mdss-pan-physical-height-dimension = <217>;
};

&dsi_nt35521_wxga_video {
	qcom,cont-splash-enabled;
	qcom,mdss-pan-physical-width-dimension = <137>;
	qcom,mdss-pan-physical-height-dimension = <217>;
};

&i2c_1 {
	status = "okay";

	kionix@e {
		compatible = "kionix,kxtj2-1009";
		reg = <0x0e>;
		vdd-supply = <&pm8916_l17>;
		vio-supply = <&pm8916_l6>;
		kionix,min_interval = <5>;
		kionix,poll_interval = <100>;

		kionix,accel_direction = <6>;
		kionix,accel_irq_use_drdy = <0>;
		kionix,accel_res = <12>;
		kionix,accel_g_range = <2>;
	};

	bosch@18 {
		compatible = "bosch,bma2x2";
		reg = <0x18>;
		interrupt-parent = <&msm_gpio>;
		interrupts = <96 0x2002>;
		vdd-supply = <&pm8916_l17>;
		vio-supply = <&pm8916_l6>;
		bosch,init-interval = <200>;
		bosch,place = <7>;
		bosch,gpio-int1 = <&msm_gpio 96 0x2002>;
		bosch,gpio-int2 = <&msm_gpio 65 0x2002>;
	};
};

&i2c_4 {
	status = "okay";

	smb358_otg_supply: smb358-charger@57 {
		compatible = "qcom,smb358-charger";
		reg = <0x57>;
		interrupt-parent = <&msm_gpio>;
		interrupts = <58 8>;
		qcom,irq-gpio = <&msm_gpio 58 0x2008>;
		pinctrl-names = "default";
		pinctrl-0 = <&smb_int_default>;
		vdd-supply = <&pm8916_l5>;
		qcom,chg-vadc = <&pm8916_vadc>;
		qcom,chg-adc_tm = <&pm8916_adc_tm>;
		qcom,chg-inhibit-disabled;
		qcom,float-voltage-mv = <4350>;
		qcom,iterm-ma = <200>;
		qcom,recharge-thresh-mv = <100>;
		qcom,recharge-mv = <100>;
		qcom,thermal-mitigation = <1500 700 600 0>;
		qcom,fg-auto-recharge-soc = <98>;

		qcom,bms-psy-name = "coulometer";
		regulator-name = "smb358_otg_vreg";
		qcom,cold-bat-decidegc = <0>;
		qcom,cool-bat-decidegc = <150>;
		qcom,warm-bat-decidegc = <450>;
		qcom,hot-bat-decidegc = <500>;
		qcom,bat-present-decidegc = <400>;
		qcom,cool-bat-ma = <1300>;
		qcom,warm-bat-ma = <1300>;
		qcom,fastchg-current-max-ma = <2000>;

		qcom,dcp-input-current-ma = <2000>;
		qcom,cool-bat-mv = <4350>;
		qcom,warm-bat-mv = <4100>;
		qcom,soc-delay-worker-time = <15000>;
	};
};

&mtp_batterydata {
	qcom,rpull-up-kohm = <0>;
	qcom,vref-batt-therm = <1800000>;

	/delete-node/ qcom,palladium-batterydata;

	qcom,qrd-4v35-2500mAh-data {
		qcom,battery-type = "qrd_4v35_2500mah";
		qcom,batt-id-kohm = <470>;
		qcom,chg-term-ua = <100000>;
		qcom,default-rbatt-mohm = <198>;
		qcom,rbatt-capacitive-mohm = <30>;
		qcom,fcc-mah = <7000>;
		qcom,flat-ocv-threshold-uv = <3800000>;
		qcom,max-voltage-uv = <4350000>;
		qcom,v-cutoff-uv = <3400000>;

