&pm8916_bms {
	status = "okay";
	qcom,battery-data = <&mtp_batterydata>;
	qcom,v-cutoff-uv = <3450000>;
	qcom,max-voltage-uv = <4350000>;
	qcom,shutdown-soc-valid-limit = <30>;
	qcom,low-voltage-calculate-soc-ms = <30000>;
	qcom,low-soc-calculate-soc-ms = <80000>;
	qcom,calculate-soc-ms = <110000>;
	qcom,low-voltage-threshold = <3550000>;
	qcom,resume-soc = <95>;
	qcom,use-reported-soc;
	qcom,force-bms-active-on-charger;
	qcom,batt-aging-comp;
};

&msm_gpio {
	ctp_eint_as_int: ctp_eint_as_int {
		mux {
			pins = "gpio13";
			function = "gpio";
		};
		config {
			pins = "gpio13";
			drive-strength = <8>;
			input-enable;
			bias-disable;
		};
	};

	ctp_eint_output_low: ctp_eint_output_low {
		mux {
			pins = "gpio13";
			function = "gpio";
		};
		config {
			pins = "gpio13";
			drive-strength = <8>;
			bias-pull-down;
			output-low;
		};
	};

	ctp_eint_output_high: ctp_eint_output_high {
		mux {
			pins = "gpio13";
			function = "gpio";
		};
		config {
			pins = "gpio13";
			drive-strength = <8>;
			bias-pull-up;
			output-high;
		};
	};

	spk_ext_pa_active: spk_ext_pa_active {
		mux {
			pins = "gpio97", "gpio20";
			function = "gpio";
		};
		config {
			pins = "gpio97", "gpio20";
			drive-strength = <8>;
			bias-disable;
			output-low;
			input-enable;
		};
	};
};

&i2c_5 {
	status = "okay";

	synaptics@20 {
		status = "disabled";
	};

	Goodix-TS@14 {
		compatible = "goodix,Goodix-TS";
		reg = <0x14>;
		interrupt-parent = <&msm_gpio>;
		interrupts = <13 0x2008>;
		vdd-supply = <&pm8916_l17>;
		vcc_i2c-supply = <&pm8916_l6>;
		pinctrl-names = "eint_as_int", "eint_output_low",
				"eint_output_high";
		pinctrl-0 = <&ctp_eint_as_int>;
		pinctrl-1 = <&ctp_eint_output_low>;
		pinctrl-2 = <&ctp_eint_output_high>;
		goodix,reset-gpio = <&msm_gpio 12 0x00>;
		goodix,display-coords = <0 0 1280 800>;
		goodix,panel-coords = <0 0 1280 800>;
		goodix,irq-gpio = <&msm_gpio 13 0x00>;
		goodix,button-map = <158 139 172>;
		goodix,i2c-pull-up;
		status = "ok";
	};

	focaltech@38 {
		compatible = "focaltech,FT5x36";
		reg = <0x38>;
		interrupt-parent = <&msm_gpio>;
		interrupts = <13 0x2>;
		vdd-supply = <&pm8916_l17>;
		vcc_i2c-supply = <&pm8916_l6>;
		pinctrl-names = "pmx_ts_active", "pmx_ts_suspend";
		pinctrl-0 = <&ts_int_active &ts_reset_active>;
		pinctrl-1 = <&ts_int_suspend &ts_reset_suspend>;
		focaltech,family-id = <0x8>;
		focaltech,reset-gpio = <&msm_gpio 12 0x0>;
		focaltech,irq-gpio = <&msm_gpio 13 0x0>;
		focaltech,max_touch_point = <10>;
		focaltech,display-coords = <0 0 800 1280>;
		focaltech,panel-coords = <0 0 800 1280>;
		focaltech,button-map = <139 172 158>;
		focaltech,no-force-update;
		focaltech,i2c-pull-up;
		focaltech,auto_clb;
	};
};

&wcnss {
	status = "okay";
};

&sdhc_2 {
	cd-gpios = <&msm_gpio 38 0x0>;
	vdd-enable-gpios = <&msm_gpio 17 0x0>;
};

&usb_otg {
	vbus_otg-supply = <&smb358_otg_supply>;
	extcon = <&smb358_otg_supply>;
};

&vendor_fstab {
	dev = "/dev/block/platform/soc/7824900.sdhci/by-name/cache";
};

&audio_codec_mtp {
	qcom,msm-mbhc-hphl-swh = <1>;
	qcom,msm-mbhc-gnd-swh = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&spk_ext_pa_active>;

	qcom,afe-legacy-clock-set;

	qcom,msm-spk-ext-pa = <&msm_gpio 97 0>;
	qcom,msm-spk-ext-pa-left = <&msm_gpio 97 0>;
	qcom,msm-spk-ext-pa-right = <&msm_gpio 20 0>;

	qcom,cdc-us-euro-gpios = <&msm_gpio 16 0>;
	/delete-property/ qcom,cdc-us-eu-gpios;

	/delete-property/ qcom,msm-micbias1-ext-cap;
	qcom,audio-routing =
		"RX_BIAS", "MCLK",
		"SPK_RX_BIAS", "MCLK",
		"INT_LDO_H", "MCLK",
		"MIC BIAS Internal1", "Handset Mic",
		"MIC BIAS Internal2", "Headset Mic",
		"MIC BIAS Internal3", "Secondary Mic",
		"AMIC1", "MIC BIAS Internal1",
		"AMIC2", "MIC BIAS Internal2",
		"AMIC3", "MIC BIAS Internal3";
};

&cdc_us_euro_sw {
	status = "disabled";
};

&i2c_2 {
	nq@28 {
		status = "disabled";
	};

	couloMeter@55 {
		compatible = "ti,bq27500";
		reg = <0x55>;
		ti,supply-name = "coulometer";
	};
};
